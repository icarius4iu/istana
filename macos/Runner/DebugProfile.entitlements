<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<!-- Bajo App Sandbox, TODA conexión saliente (HTTP/WebSocket del backend,
	     y el socket cliente de la transferencia P2P) exige esta entitlement
	     explícita — sin ella el sandbox la bloquea en silencio. -->
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.network.server</key>
	<true/>
	<!-- Requerido por file_picker (NSOpenPanel) bajo App Sandbox: sin esto
	     el picker no puede devolver acceso al archivo elegido. -->
	<key>com.apple.security.files.user-selected.read-only</key>
	<true/>
</dict>
</plist>
